# Copy to server/.env — never commit the real file (it's gitignored).
# With this set, the Copilot works without any key in the browser:
# the app calls POST /api/copilot and the key never leaves your machine.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# PORT=8787
# BRRRR_DB=/absolute/path/to/brrrr.db
